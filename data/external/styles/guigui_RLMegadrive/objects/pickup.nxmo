EFFECT PICKUPSKILL
TRIGGER_X 1
TRIGGER_Y 8
TRIGGER_WIDTH 10
TRIGGER_HEIGHT 8

DIGIT_X 6
DIGIT_Y 16
DIGIT_ALIGNMENT CENTER
DIGIT_LENGTH 0

$PRIMARY_ANIMATION
  NAME *PICKUP
  OFFSET_X -6
  OFFSET_Y -6
$END

$ANIMATION
  FRAMES 2
  NAME skill_mask
  HIDE
$END

$ANIMATION
  FRAMES 7
  NAME anim

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END